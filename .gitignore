# =============================================================================
# Legacy code superseded by the reorganization.
# Previous-version Python pipeline lives under legacy/ for reference but is NOT
# tracked. The replacement code lives under src/eeg_steptype/ and scripts/.
# See legacy/README.md for the old-file -> new-file mapping.
# =============================================================================
legacy/
sandbox/
_repo_export/
.artifact-sync-backups/

# Legacy CSV from old SRC_writer.py (top-level src/ — different from new src/eeg_steptype/)
/src/*.csv

# =============================================================================
# Data files — too large for Git, regenerate from the preprocessing scripts.
# See data/README.md for details on the expected files.
# =============================================================================

# Master epoch CSV (~4.9 GB), produced by legacy 01_preprocessing/CNV_epoch_extraction.py
CNV_epochs_df.csv

# R-side disk-format dataframes
CNV_ch_df_full_disk.rds
CNV_ch_df_sub_disk.rds
CNV_binned.rds

# New pipeline data and outputs (regenerable, large)
data/interim/
data/features/
data/src/
outputs/runs/
outputs/qc/
outputs/figs/
outputs/*.log
outputs/*.log.done

# state-module run logs (large, regenerable) — keep figs/qc/runs artifacts tracked
outputs/state_module/logs/

# perf-loop run logs are large (90 MB+) and regenerable; keep the LEDGER /
# SUMMARY markdown and the harness scripts (aggregate.py, screen.sh, *.sh) tracked.
outputs/perf_loop/*.log
outputs/perf_loop/*.stalled
outputs/perf_loop/__pycache__/
# Machine-specific run-config snapshots (absolute paths); like outputs/runs/ configs.
outputs/perf_loop/*_cfg.yaml

# Per-machine config (committed copy lives at configs/local.yaml.example)
configs/local.yaml

# Temporary / experimental overlay configs (underscore-prefixed, e.g. _run5_quick.yaml)
configs/_*.yaml

# Anything else placed in data/ outside the README
data/*
!data/README.md
!data/.gitkeep

# Raw EEG and intermediate artifacts
*.fif
*.bdf
*.rds
*.parquet

# =============================================================================
# RStudio session files
# =============================================================================
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
venv/
.venv/
.venv312/
env/

# =============================================================================
# IDE / editor
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================================
# OS
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# Empty leftover dir from reorganization (figs/ contents moved to outputs/figs/)
# =============================================================================
/figs/

# Secondary Python 3.12 venv for TensorFlow-backed neural models (Py3.14 has no TF wheels)
.venv312/
